---
import { getPool, initDB } from '../lib/db';
import { INTRO, FIFA_MUSEUM, TEAMS, COCA_COLA } from '../lib/stickers';

await initDB();
const { rows } = await getPool().query('SELECT id, owned, repeated FROM stickers');
const ownedSet = new Set(rows.filter(r => r.owned).map(r => r.id));
const repeatedMap = new Map(rows.filter(r => r.repeated > 0).map(r => [r.id, r.repeated as number]));

const totalAll = rows.length;
const totalOwned = ownedSet.size;

// precompute repeated stickers grouped by section
const allWithSection = [
  ...INTRO.map(s => ({ ...s, section: 'Introducción', flag: '🌍' })),
  ...TEAMS.flatMap(t => t.stickers.map(s => ({ ...s, section: t.name, flag: t.flag }))),
  ...FIFA_MUSEUM.map(s => ({ ...s, section: 'FIFA Museum', flag: '🏆' })),
  ...COCA_COLA.map(s => ({ ...s, section: 'Coca-Cola', flag: '🥤' })),
];
const repeatedStickers = allWithSection.filter(s => (repeatedMap.get(s.id) ?? 0) > 0);
const repeatedBySection = repeatedStickers.reduce((acc, s) => {
  if (!acc[s.section]) acc[s.section] = { flag: s.flag, items: [] };
  acc[s.section].items.push(s);
  return acc;
}, {} as Record<string, { flag: string; items: typeof allWithSection }>);

function repBadge(id: string) {
  const count = repeatedMap.get(id);
  return count ? count : 0;
}
const allSections = [
  { code: 'intro', name: 'Introducción', flag: '🌍', stickers: INTRO },
  ...TEAMS.map(t => ({ code: t.code, name: t.name, flag: t.flag, stickers: t.stickers })),
  { code: 'museum', name: 'FIFA Museum', flag: '🏆', stickers: FIFA_MUSEUM },
  { code: 'cocacola', name: 'Coca-Cola', flag: '🥤', stickers: COCA_COLA },
].map(s => {
  const owned = s.stickers.filter(x => ownedSet.has(x.id)).length;
  const pct = Math.round(owned / s.stickers.length * 100);
  return { ...s, owned, total: s.stickers.length, pct };
}).sort((a, b) => a.pct - b.pct);
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Álbum Leo & Gabi 2026</title>
  <script src="https://code.iconify.design/iconify-icon/2.3.0/iconify-icon.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f1f5f9; color: #1e293b; min-height: 100dvh; -webkit-tap-highlight-color: transparent; }
    .app { max-width: 480px; margin: 0 auto; background: #f1f5f9; }
    header { background: #f1f5f9; padding: 0.7rem 1rem 0.5rem; text-align: center; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    header h1 { font-size: 1rem; font-weight: 800; color: #1e293b; }
    header p { font-size: 0.68rem; color: #475569; margin-top: 0.1rem; }
    .logout { position: absolute; top: 0.6rem; right: 0.75rem; font-size: 0.68rem; color: #475569; text-decoration: none; }
    .global-stats { display: flex; gap: 1rem; justify-content: center; margin-top: 0.3rem; font-size: 0.72rem; color: #94a3b8; }
    .global-stats strong { color: #94a3b8; }
    .progress-bar { width: 100%; margin: 0.35rem auto 0; height: 4px; background: #ffffff; border-radius: 2px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, #38bdf8, #818cf8); border-radius: 2px; transition: width 0.3s; }
    .hamburger { position: absolute; top: 0.7rem; left: 0.75rem; background: none; border: none; color: #94a3b8; font-size: 1.3rem; cursor: pointer; padding: 0.2rem; }
    .drawer-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 150; }
    .drawer-overlay.open { display: block; }
    .drawer { position: fixed; top: 0; left: 0; height: 100%; width: 220px; background: #ffffff; z-index: 151; transform: translateX(-100%); transition: transform 0.25s; padding: 1.5rem 0; }
    .drawer.open { transform: translateX(0); }
    .drawer-title { font-size: 0.7rem; color: #475569; padding: 0 1.25rem 0.5rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .drawer-item { display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1.25rem; font-size: 0.9rem; color: #94a3b8; cursor: pointer; transition: background 0.1s; }
    .drawer-item:active, .drawer-item.active { background: #f1f5f9; color: #1e293b; }
    .drawer-item.active { border-left: 3px solid #38bdf8; padding-left: calc(1.25rem - 3px); }
    nav { display: flex; overflow-x: auto; gap: 0.4rem; padding: 0.45rem 0.75rem; background: #f1f5f9; border-bottom: 1px solid #e2e8f0; position: sticky; top: 82px; z-index: 98; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    nav a { flex-shrink: 0; font-size: 0.68rem; padding: 0.25rem 0.55rem; border-radius: 20px; background: #ffffff; color: #94a3b8; text-decoration: none; white-space: nowrap; border: 1px solid #cbd5e0; }
    nav a:active { background: #334155; color: #1e293b; }
    main { padding: 0.75rem; }
    .section { margin-bottom: 1.5rem; scroll-margin-top: 120px; }
    .section-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; padding-bottom: 0.3rem; border-bottom: 1px solid #e2e8f0; cursor: pointer; }
    .section-header h2 { font-size: 0.88rem; font-weight: 700; color: #1e293b; }
    .section-flag { font-size: 1.2rem; line-height: 1; }
    .section-count { margin-left: auto; font-size: 0.68rem; color: #475569; }
    .section-count.complete { color: #4ade80; font-weight: 700; }
    .section-header .chevron { margin-left: 0.3rem; font-size: 0.7rem; color: #475569; transition: transform 0.2s; }
    .section.collapsed .sticker-grid { display: none; }
    .section.collapsed .chevron { transform: rotate(-90deg); }
    .sticker-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
    @media (min-width: 400px) { .sticker-grid { grid-template-columns: repeat(6, 1fr); } }
    @media (min-width: 600px) { .sticker-grid { grid-template-columns: repeat(8, 1fr); } }
    .sticker { aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 7px; cursor: pointer; border: 1.5px solid transparent; transition: transform 0.08s; user-select: none; padding: 3px; position: relative; }
    .sticker:active { transform: scale(0.91); }
    .rbadge { position: absolute; top: 2px; right: 2px; background: #38bdf8; color: #fff; font-size: 0.45rem; font-weight: 800; min-width: 14px; height: 14px; border-radius: 7px; display: none; align-items: center; justify-content: center; padding: 0 3px; pointer-events: none; z-index: 1; }
    .rep-popup { position: fixed; z-index: 210; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); padding: 0.6rem; display: flex; align-items: center; gap: 0.75rem; }
    .rep-popup button { width: 36px; height: 36px; border-radius: 50%; border: 1px solid #e2e8f0; background: #f8fafc; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .rep-popup button:active { background: #e2e8f0; }
    .rep-popup .rp-count { font-size: 1rem; font-weight: 800; min-width: 24px; text-align: center; color: #1e293b; }
    .rep-popup .rp-label { font-size: 0.65rem; color: #64748b; }
    .sticker .sid { font-size: 0.56rem; font-weight: 700; line-height: 1; }
    .sticker .sname { font-size: 0.4rem; line-height: 1.15; text-align: center; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 1px; }
    .sticker.owned   { background: #166534; border-color: #4ade80; color: #bbf7d0; }
    .sticker.missing { background: #ffffff; border-color: #cbd5e0; color: #475569; }
    .sticker.foil.owned   { background: linear-gradient(135deg, #854d0e, #ca8a04); border-color: #fbbf24; color: #fef9c3; }
    .sticker.foil.missing { background: #fffbeb; border-color: #fde68a; color: #b45309; }
    .sticker.photo.owned   { background: #1e3a5f; border-color: #38bdf8; color: #bae6fd; }
    .sticker.photo.missing { background: #eff6ff; border-color: #bfdbfe; color: #93c5fd; }
    #view-heatmap { display: none; }
    #view-heatmap.visible { display: block; }
    .hidden { display: none !important; }
    .heatmap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .hm-card { border-radius: 10px; padding: 0.6rem 0.5rem 0.5rem; display: flex; flex-direction: column; gap: 0.3rem; border: 1px solid #e2e8f0; cursor: pointer; }
    .hm-top { display: flex; align-items: center; gap: 0.4rem; }
    .hm-flag { font-size: 1.3rem; line-height: 1; }
    .hm-name { font-size: 0.7rem; font-weight: 700; color: #1e293b; line-height: 1.2; }
    .hm-pct { margin-left: auto; font-size: 0.75rem; font-weight: 800; }
    .hm-bar { height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
    .hm-fill { height: 100%; border-radius: 3px; transition: width 0.3s; }
    .hm-count { font-size: 0.6rem; color: #94a3b8; }
    .fab { position: fixed; right: max(1.25rem, calc(50vw - 240px + 1.25rem)); z-index: 200; width: 48px; height: 48px; border-radius: 50%; border: none; font-size: 1.2rem; cursor: pointer; display: flex; align-items: center; justify-content: center; touch-action: manipulation; }
    .fab-search { bottom: 1.25rem; background: #38bdf8; color: #0f172a; box-shadow: 0 4px 14px rgba(56,189,248,0.4); }
    .fab-edit { bottom: 5rem; background: #ffffff; color: #94a3b8; border: 1.5px solid #cbd5e0 !important; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .fab-edit.mode-edit { background: #166534; color: #fff; border-color: #4ade80 !important; }
    .fab-edit.mode-repeat { background: #1e3a5f; color: #fff; border-color: #38bdf8 !important; }
    .search-overlay { display: none; position: fixed; inset: 0; z-index: 199; background: rgba(0,0,0,0.4); align-items: flex-start; justify-content: center; padding-top: 5rem; }
    .search-overlay.open { display: flex; }
    .search-box { background: #ffffff; border-radius: 14px; padding: 1rem; width: 90%; max-width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); }
    .search-box input { width: 100%; border: 1.5px solid #cbd5e0; border-radius: 8px; padding: 0.6rem 0.75rem; font-size: 1rem; outline: none; color: #1e293b; background: #f1f5f9; }
    .search-box input:focus { border-color: #38bdf8; }
    .search-results { margin-top: 0.6rem; max-height: 50vh; overflow-y: auto; }
    .search-result { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.6rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem; color: #1e293b; margin-bottom: 3px; }
    .search-result.owned   { background: #166534; color: #bbf7d0; }
    .search-result.missing { background: #ffffff; color: #94a3b8; }
    .search-result:active { filter: brightness(1.2); }
    .search-result .sr-id { font-weight: 700; min-width: 52px; font-size: 0.75rem; }
    .search-empty { font-size: 0.8rem; color: #475569; text-align: center; padding: 1rem; }

    /* repeated view */
    #view-repeated { display: none; padding: 0.75rem; }
    #view-repeated.visible { display: block; }
    .rep-search { width: 100%; border: 1.5px solid #cbd5e0; border-radius: 8px; padding: 0.55rem 0.75rem; font-size: 0.9rem; background: #ffffff; color: #1e293b; outline: none; margin-bottom: 0.75rem; }
    .rep-search:focus { border-color: #38bdf8; }
    .rep-empty { text-align: center; color: #475569; font-size: 0.85rem; padding: 2rem 1rem; }
    .rep-sticker {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.5rem 0.6rem; border-radius: 8px;
      background: #ffffff; border: 1px solid #cbd5e0;
      margin-bottom: 4px;
    }
    .rep-sticker .rs-id { font-size: 0.7rem; font-weight: 800; color: #38bdf8; min-width: 52px; }
    .rep-sticker .rs-name { font-size: 0.82rem; color: #1e293b; flex: 1; }
    .rep-sticker .rs-count { font-size: 0.75rem; font-weight: 700; color: #4ade80; min-width: 24px; text-align: center; }
    .rep-sticker .rs-del { background: #3b0f0f; border: 1px solid #f87171; color: #f87171; border-radius: 6px; padding: 0.2rem 0.5rem; font-size: 0.75rem; cursor: pointer; }
    .rep-add-btn { width: 100%; padding: 0.65rem; background: #ffffff; color: #38bdf8; border: 1.5px dashed #334155; border-radius: 10px; font-size: 0.85rem; cursor: pointer; margin-bottom: 0.75rem; }

    /* scan view */
    #view-scan { display: none; padding: 1rem; }
    #view-scan.visible { display: block; }
    .scan-drop { border: 2px dashed #334155; border-radius: 12px; padding: 2rem 1rem; text-align: center; cursor: pointer; color: #94a3b8; font-size: 0.85rem; transition: border-color 0.15s; }
    .scan-drop:active { border-color: #38bdf8; }
    .scan-preview { width: 100%; border-radius: 10px; margin-top: 0.75rem; display: none; min-height: 40px; }
    .scan-preview.visible { display: block; }
    .scan-preview:not([src]), .scan-preview[src=""] { display: flex; align-items: center; justify-content: center; background: #ffffff; color: #94a3b8; font-size: 0.8rem; padding: 1rem; border-radius: 10px; }
    .scan-btn { width: 100%; margin-top: 0.75rem; padding: 0.7rem; background: #38bdf8; color: #0f172a; border: none; border-radius: 10px; font-size: 0.9rem; font-weight: 700; cursor: pointer; display: none; }
    .scan-btn.visible { display: block; }
    .scan-results { margin-top: 1rem; }
    .scan-group { margin-bottom: 0.75rem; }
    .scan-group h3 { font-size: 0.75rem; font-weight: 700; margin-bottom: 0.5rem; }
  </style>
  <style is:global>
    .scan-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; margin-top: 0.5rem; }
    @media (min-width: 400px) { .scan-grid { grid-template-columns: repeat(6, 1fr); } }
    .scan-card { aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 7px; border: 1.5px solid transparent; padding: 3px; }
    .scan-card.owned   { background: #166534; border-color: #4ade80; color: #bbf7d0; }
    .scan-card.missing { background: #3b0f0f; border-color: #f87171; color: #fecaca; }
    .scan-card .sc-code { font-size: 0.56rem; font-weight: 700; line-height: 1; }
    .scan-card .sc-name { font-size: 0.4rem; line-height: 1.15; text-align: center; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 1px; }
    .scan-loading { text-align: center; color: #94a3b8; font-size: 0.85rem; padding: 1rem; }
    .search-result { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.6rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem; margin-bottom: 3px; }
    .search-result.owned   { background: #166534; color: #bbf7d0; }
    .search-result.missing { background: #ffffff; color: #94a3b8; }
    .search-result:active { filter: brightness(1.2); }
    .search-result .sr-id { font-weight: 700; min-width: 52px; font-size: 0.75rem; }
    .rep-popup { position: fixed; z-index: 210; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); padding: 0.6rem; display: flex; align-items: center; gap: 0.75rem; }
    .rep-popup button { width: 36px; height: 36px; border-radius: 50%; border: 1px solid #e2e8f0; background: #f8fafc; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .rep-popup button:active { background: #e2e8f0; }
    .rep-popup .rp-count { font-size: 1rem; font-weight: 800; min-width: 24px; text-align: center; color: #1e293b; }
    .rep-popup .rp-label { font-size: 0.65rem; color: #64748b; }
    .rbadge { position: absolute; top: 2px; right: 2px; background: #38bdf8; color: #fff; font-size: 0.45rem; font-weight: 800; min-width: 14px; height: 14px; border-radius: 7px; display: flex; align-items: center; justify-content: center; padding: 0 3px; pointer-events: none; z-index: 1; }
  </style>
</head>
<body>
  <div class="app">
  <header>

    <button class="hamburger" id="hamburger"><iconify-icon icon="mdi:menu" width="20"></iconify-icon></button>
    <h1>Álbum de Leo & Gabi</h1>
    <p>⚽ Panini FIFA World Cup 2026™</p>
    <div class="global-stats">
      <span>Tengo: <strong id="g-owned">{totalOwned}</strong></span>
      <span>Faltan: <strong id="g-missing">{totalAll - totalOwned}</strong></span>
      <span>Total: <strong>{totalAll}</strong></span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" id="g-bar" style={`width:${(totalOwned/totalAll*100).toFixed(1)}%`}></div>
    </div>
  </header>

  <div class="drawer-overlay" id="drawer-overlay"></div>
  <div class="drawer" id="drawer">
    <div class="drawer-title">Menú</div>
    <div class="drawer-item active" data-tab="stickers"><iconify-icon icon="mdi:sticker-outline" width="18"></iconify-icon> Stickers</div>
    <div class="drawer-item" data-tab="heatmap"><iconify-icon icon="mdi:chart-bar" width="18"></iconify-icon> Por país</div>
    <!--<div class="drawer-item" data-tab="repeated">🔄 Repetidas</div>-->
    <div class="drawer-item" data-tab="scan"><iconify-icon icon="mdi:camera-outline" width="18"></iconify-icon> Escanear</div>
  </div>


  <!-- STICKERS VIEW -->
  <div id="view-stickers">
    <main>
      <div class="section collapsed" id="intro">
        <div class="section-header" data-toggle="intro">
          <span class="section-flag"><iconify-icon icon="mdi:earth" width="20"></iconify-icon></span>
          <h2>Introducción</h2>
          <span class="section-count" id="cnt-intro">{INTRO.filter(s => ownedSet.has(s.id)).length}/{INTRO.length}</span>
          <span class="chevron">▾</span>
        </div>
        <div class="sticker-grid">
          {INTRO.map(s => (
            <div class={`sticker foil ${ownedSet.has(s.id) ? 'owned' : 'missing'}`} data-id={s.id} data-section="intro" title={`${s.id} - ${s.name}`}>
              <span class="sid">{s.id}</span>
              <span class="sname">{s.name}</span>
            </div>
          ))}
        </div>
      </div>

      {TEAMS.map(t => {
        const teamOwned = t.stickers.filter(s => ownedSet.has(s.id)).length;
        return (
          <div class="section collapsed" id={t.code}>
            <div class="section-header" data-toggle={t.code}>
              <span class="section-flag">{t.flag}</span>
              <h2>{t.name}</h2>
              <span class={`section-count ${teamOwned === t.stickers.length ? 'complete' : ''}`} id={`cnt-${t.code}`}>{teamOwned}/{t.stickers.length}</span>
              <span class="chevron">▾</span>
            </div>
            <div class="sticker-grid">
              {t.stickers.map(s => (
                <div
                  class={`sticker ${s.foil ? 'foil' : s.name === 'Team Photo' ? 'photo' : ''} ${ownedSet.has(s.id) ? 'owned' : 'missing'}`}
                  data-id={s.id} data-section={t.code} title={`${s.id} - ${s.name}`}
                >
                  <span class="sid">{s.id}</span>
                  <span class="sname">{s.name}</span>
                  {repBadge(s.id) > 0 && <span class="rbadge" id={`rbadge-${s.id}`}>{repBadge(s.id)}</span>}
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <div class="section collapsed" id="museum">
        <div class="section-header" data-toggle="museum">
          <span class="section-flag"><iconify-icon icon="mdi:trophy" width="20"></iconify-icon></span>
          <h2>FIFA Museum</h2>
          <span class="section-count" id="cnt-museum">{FIFA_MUSEUM.filter(s => ownedSet.has(s.id)).length}/{FIFA_MUSEUM.length}</span>
          <span class="chevron">▾</span>
        </div>
        <div class="sticker-grid">
          {FIFA_MUSEUM.map(s => (
            <div class={`sticker foil ${ownedSet.has(s.id) ? 'owned' : 'missing'}`} data-id={s.id} data-section="museum" title={`${s.id} - ${s.name}`}>
              <span class="sid">{s.id}</span>
              <span class="sname">{s.name}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="section collapsed" id="cocacola">
        <div class="section-header" data-toggle="cocacola">
          <span class="section-flag"><iconify-icon icon="mdi:bottle-soda-classic" width="20"></iconify-icon></span>
          <h2>Coca-Cola</h2>
          <span class="section-count" id="cnt-cocacola">{COCA_COLA.filter(s => ownedSet.has(s.id)).length}/{COCA_COLA.length}</span>
          <span class="chevron">▾</span>
        </div>
        <div class="sticker-grid">
          {COCA_COLA.map(s => (
            <div class={`sticker ${ownedSet.has(s.id) ? 'owned' : 'missing'}`} data-id={s.id} data-section="cocacola" title={`${s.id} - ${s.name}`}>
              <span class="sid">{s.id}</span>
              <span class="sname">{s.name}</span>
            </div>
          ))}
        </div>
      </div>
    </main>
  </div>

  <!-- HEATMAP VIEW -->
  <div id="view-heatmap">
    <main>
      <div class="heatmap-grid">
        {allSections.map(t => {
          // color: 0%=red, 50%=orange, 100%=green
          const r = t.pct < 50 ? 255 : Math.round(255 - (t.pct - 50) * 5.1);
          const g = t.pct < 50 ? Math.round(t.pct * 5.1) : 255;
          const bg = `rgba(${r},${g},80,0.15)`;
          const fill = `rgb(${r},${g},80)`;
          return (
            <div class="hm-card" style={`background:${bg}`} data-goto={t.code}>
              <div class="hm-top">
                <span class="hm-flag">{t.flag}</span>
                <span class="hm-name">{t.name}</span>
                <span class="hm-pct" style={`color:${fill}`}>{t.pct}%</span>
              </div>
              <div class="hm-bar"><div class="hm-fill" id={`hm-${t.code}`} style={`width:${t.pct}%;background:${fill}`}></div></div>
              <span class="hm-count" id={`hmc-${t.code}`}>{t.owned}/{t.total} figuritas</span>
            </div>
          );
        })}
      </div>
    </main>
  </div>

  <!-- REPEATED VIEW -->
  <div id="view-repeated">
    <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem">
      <input class="rep-search" id="rep-search" type="text" placeholder="Buscar en repetidas..." autocomplete="off" style="flex:1;margin:0" />
      <button id="rep-add-open" style="padding:0.5rem 0.75rem;background:#ffffff;color:#38bdf8;border:1.5px solid #334155;border-radius:8px;font-size:0.85rem;cursor:pointer;white-space:nowrap">+ Agregar</button>
    </div>

    <!-- add modal -->
    <div id="rep-add-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:200;align-items:flex-start;justify-content:center;padding-top:4rem">
      <div style="background:#ffffff;border-radius:14px;padding:1rem;width:90%;max-width:380px">
        <input id="rep-add-search" type="text" placeholder="Buscar sticker..." autocomplete="off"
          style="width:100%;border:1.5px solid #334155;border-radius:8px;padding:0.6rem 0.75rem;font-size:1rem;background:#f1f5f9;color:#1e293b;outline:none;margin-bottom:0.5rem" />
        <div id="rep-add-results" style="max-height:50vh;overflow-y:auto"></div>
      </div>
    </div>

    <div id="rep-list">
      {repeatedStickers.length === 0
        ? <p class="rep-empty">No tenés repetidas aún.</p>
        : Object.entries(repeatedBySection).map(([section, { flag, items }]) => (
          <div class="section">
            <div class="section-header" style="cursor:default">
              <span class="section-flag">{flag}</span>
              <h2>{section}</h2>
              <span class="section-count">{items.length}</span>
            </div>
            {items.map(s => (
              <div class="rep-sticker" data-rep-id={s.id}>
                <span class="rs-id">{s.id}</span>
                <span class="rs-name">{s.name}</span>
                <span class="rs-count" id={`rc-${s.id}`}>x{repeatedMap.get(s.id)}</span>
                <button class="rs-del" data-del={s.id}>−</button>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- SCAN VIEW -->
  <div id="view-scan">
    <div style="display:flex;gap:0.5rem;margin-top:0.75rem">
      <button style="flex:1;padding:0.65rem;background:#ffffff;color:#1e293b;border:1px solid #334155;border-radius:10px;font-size:0.85rem;cursor:pointer" id="btn-camera"><iconify-icon icon="mdi:camera" width="16"></iconify-icon> Cámara</button>
      <button style="flex:1;padding:0.65rem;background:#ffffff;color:#1e293b;border:1px solid #334155;border-radius:10px;font-size:0.85rem;cursor:pointer" id="btn-file">🖼 Archivo</button>
    </div>
    <input type="file" id="scan-input-camera" accept="image/*" capture="environment" style="display:none" />
    <input type="file" id="scan-input-file" accept="image/*" style="display:none" />
    <img id="scan-preview" class="scan-preview" alt="preview" />
    <button class="scan-btn" id="scan-btn"><iconify-icon icon="mdi:magnify-scan" width="18"></iconify-icon> Reconocer cartas</button>
    <div class="scan-results" id="scan-results"></div>
  </div>

  <!-- FABs -->
  <button class="fab fab-edit" id="fab-edit"><iconify-icon icon="mdi:pencil-outline" width="22"></iconify-icon></button>
  <button class="fab fab-search" id="fab-search"><iconify-icon icon="mdi:magnify" width="22"></iconify-icon></button>
  <div class="search-overlay" id="search-overlay">
    <div class="search-box">
      <input type="text" id="search-input" placeholder="Buscar jugador o ID..." autocomplete="off" />
      <div class="search-results" id="search-results"></div>
    </div>
  </div>

  <script>
    const totalAll = document.querySelectorAll('.sticker').length;

    // COLLAPSIBLE
    document.querySelectorAll('[data-toggle]').forEach(header => {
      header.addEventListener('click', () => header.closest('.section').classList.toggle('collapsed'));
    });

    // HAMBURGER
    const drawer = document.getElementById('drawer');
    const overlay = document.getElementById('drawer-overlay');
    document.getElementById('hamburger').addEventListener('click', () => {
      drawer.classList.add('open'); overlay.classList.add('open');
    });
    overlay.addEventListener('click', () => {
      drawer.classList.remove('open'); overlay.classList.remove('open');
    });

    // TABS
    function switchTab(tab) {
      document.getElementById('view-stickers').classList.toggle('hidden', tab !== 'stickers');
      document.getElementById('view-heatmap').classList.toggle('hidden', tab !== 'heatmap');
      document.getElementById('view-heatmap').classList.toggle('visible', tab === 'heatmap');
      document.getElementById('view-repeated').classList.toggle('visible', tab === 'repeated');
      document.getElementById('view-scan').classList.toggle('visible', tab === 'scan');
      document.querySelectorAll('.drawer-item').forEach(el => el.classList.toggle('active', el.dataset.tab === tab));
      drawer.classList.remove('open'); overlay.classList.remove('open');
    }
    document.querySelectorAll('.drawer-item').forEach(el => el.addEventListener('click', () => switchTab(el.dataset.tab)));
    document.querySelectorAll('[data-goto]').forEach(el => {
      el.addEventListener('click', () => {
        switchTab('stickers');
        setTimeout(() => document.getElementById(el.dataset.goto)?.scrollIntoView({ behavior: 'smooth' }), 50);
      });
    });

    // SEARCH
    const allStickers = Array.from(document.querySelectorAll('.sticker')).map(el => ({
      el, id: el.dataset.id, section: el.dataset.section,
      name: el.querySelector('.sname')?.textContent ?? '',
    }));

    document.getElementById('fab-search').addEventListener('click', () => {
      document.getElementById('search-overlay').classList.add('open');
      setTimeout(() => document.getElementById('search-input').focus(), 50);
    });
    document.getElementById('search-overlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeSearch();
    });
    function closeSearch() {
      document.getElementById('search-overlay').classList.remove('open');
      document.getElementById('search-input').value = '';
      document.getElementById('search-results').innerHTML = '';
    }
    document.getElementById('search-input').addEventListener('input', e => {
      const q = e.target.value.trim().toLowerCase();
      const results = document.getElementById('search-results');
      if (!q) { results.innerHTML = ''; return; }
      const matches = allStickers.filter(s => s.id.toLowerCase().includes(q) || s.name.toLowerCase().includes(q)).slice(0, 20);
      if (!matches.length) { results.innerHTML = '<div class="search-empty">Sin resultados</div>'; return; }
      results.innerHTML = matches.map((s, i) =>
        `<div class="search-result ${s.el.classList.contains('owned') ? 'owned' : 'missing'}" data-idx="${i}">
          <span class="sr-id">${s.id}</span>
          <span>${s.name}</span>
        </div>`
      ).join('');
      results.querySelectorAll('.search-result').forEach((row, i) => {
        row.addEventListener('click', () => {
          closeSearch();
          switchTab('stickers');
          const sec = document.getElementById(matches[i].section);
          if (sec?.classList.contains('collapsed')) sec.classList.remove('collapsed');
          setTimeout(() => {
            matches[i].el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            matches[i].el.style.outline = '3px solid #4299e1';
            setTimeout(() => matches[i].el.style.outline = '', 1500);
          }, 80);
        });
      });
    });

    // HEATMAP
    function heatColor(pct) {
      const r = pct < 50 ? 255 : Math.round(255 - (pct - 50) * 5.1);
      const g = pct < 50 ? Math.round(pct * 5.1) : 255;
      return { fill: `rgb(${r},${g},80)`, bg: `rgba(${r},${g},80,0.15)` };
    }

    // EDIT MODE: off -> edit -> repeat -> off
    let mode = 'off'; // 'off' | 'edit' | 'repeat'
    const fabEdit = document.getElementById('fab-edit');
    fabEdit.addEventListener('click', () => {
      closeRepPopup();
      if (mode === 'off') mode = 'edit';
      else if (mode === 'edit') mode = 'repeat';
      else mode = 'off';
      fabEdit.classList.remove('mode-edit', 'mode-repeat');
      if (mode === 'edit') fabEdit.classList.add('mode-edit');
      if (mode === 'repeat') fabEdit.classList.add('mode-repeat');
      console.log('[MODE]', mode);
    });

    // TOGGLE STICKER
    async function toggle(el) {
      console.log('[TOGGLE] mode=', mode, 'id=', el.dataset.id);
      if (mode === 'off') return;
      if (mode === 'repeat') { showRepPopup(el); return; }
      // mode === 'edit'
      const id = el.dataset.id;
      const section = el.dataset.section;
      const isOwned = el.classList.contains('owned');
      const newOwned = !isOwned;

      if (isOwned) {
        const name = el.querySelector('.sname')?.textContent?.trim() || id;
        if (!confirm(`¿Quitar ${id} (${name}) de tu colección?`)) return;
      }

      await fetch('/api/sticker', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, owned: newOwned }),
      });
      el.classList.toggle('owned', newOwned);
      el.classList.toggle('missing', !newOwned);

      const grid = el.closest('.sticker-grid');
      const sOwned = grid.querySelectorAll('.sticker.owned').length;
      const sTotal = grid.querySelectorAll('.sticker').length;
      const cnt = document.getElementById(`cnt-${section}`);
      if (cnt) { cnt.textContent = `${sOwned}/${sTotal}`; cnt.classList.toggle('complete', sOwned === sTotal); }

      const pct = Math.round(sOwned / sTotal * 100);
      const { fill, bg } = heatColor(pct);
      const bar = document.getElementById(`hm-${section}`);
      if (bar) {
        bar.closest('.hm-card').style.background = bg;
        bar.style.width = pct + '%'; bar.style.background = fill;
        const pctEl = bar.closest('.hm-card').querySelector('.hm-pct');
        if (pctEl) { pctEl.textContent = pct + '%'; pctEl.style.color = fill; }
        const countEl = document.getElementById(`hmc-${section}`);
        if (countEl) countEl.textContent = `${sOwned}/${sTotal} figuritas`;
      }

      const gOwned = document.querySelectorAll('.sticker.owned').length;
      document.getElementById('g-owned').textContent = gOwned;
      document.getElementById('g-missing').textContent = totalAll - gOwned;
      document.getElementById('g-bar').style.width = `${(gOwned / totalAll * 100).toFixed(1)}%`;
    }

    // REPEATED
    async function changeRepeated(id, delta) {
      const res = await fetch('/api/repeated', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, delta }),
      });
      const { repeated } = await res.json();
      // update badge on sticker
      const sticker = document.querySelector(`.sticker[data-id="${id}"]`);
      if (sticker) {
        let badge = sticker.querySelector('.rbadge');
        if (repeated > 0) {
          if (!badge) { badge = document.createElement('span'); badge.className = 'rbadge'; badge.id = `rbadge-${id}`; sticker.appendChild(badge); }
          badge.textContent = repeated;
        } else if (badge) { badge.remove(); }
      }
      // update repeated view row
      const row = document.querySelector(`[data-rep-id="${id}"]`);
      const cnt = document.getElementById(`rc-${id}`);
      if (repeated <= 0 && row) row.remove();
      else if (cnt) cnt.textContent = `x${repeated}`;
      // check if section is now empty
      document.querySelectorAll('#rep-list .section').forEach(sec => {
        if (!sec.querySelectorAll('.rep-sticker').length) sec.remove();
      });
      if (!document.querySelectorAll('#rep-list .rep-sticker').length) {
        document.getElementById('rep-list').innerHTML = '<p class="rep-empty">No tenés repetidas aún.</p>';
      }
    }

    // Long press popup for repeated count
    let repPopup = null;
    let repPopupId = null;

    function showRepPopup(el) {
      closeRepPopup();
      const id = el.dataset.id;
      repPopupId = id;
      const name = el.querySelector('.sname')?.textContent?.trim() || id;
      const badge = el.querySelector('.rbadge');
      const count = badge ? parseInt(badge.textContent) || 0 : 0;

      const rect = el.getBoundingClientRect();

      // backdrop
      const backdrop = document.createElement('div');
      backdrop.id = 'rep-backdrop';
      backdrop.style.cssText = 'position:fixed;inset:0;z-index:209;';
      backdrop.addEventListener('click', closeRepPopup);
      document.body.appendChild(backdrop);

      repPopup = document.createElement('div');
      repPopup.className = 'rep-popup';
      repPopup.innerHTML = `
        <div style="display:flex;flex-direction:column;align-items:center">
          <span class="rp-label">${id}</span>
          <span class="rp-label">${name}</span>
        </div>
        <button id="rp-minus">−</button>
        <span class="rp-count" id="rp-val">${count}</span>
        <button id="rp-plus">+</button>
      `;
      repPopup.style.top = `${Math.max(10, rect.top - 60)}px`;
      repPopup.style.left = `${Math.max(10, Math.min(rect.left, window.innerWidth - 220))}px`;
      document.body.appendChild(repPopup);

      repPopup.querySelector('#rp-plus').addEventListener('click', async () => {
        await changeRepeated(id, 1);
        const val = repPopup.querySelector('#rp-val');
        val.textContent = parseInt(val.textContent) + 1;
      });
      repPopup.querySelector('#rp-minus').addEventListener('click', async () => {
        const val = repPopup.querySelector('#rp-val');
        const cur = parseInt(val.textContent);
        if (cur <= 0) return;
        await changeRepeated(id, -1);
        val.textContent = cur - 1;
      });
    }

    function closeRepPopup() {
      if (repPopup) { repPopup.remove(); repPopup = null; repPopupId = null; }
      const backdrop = document.getElementById('rep-backdrop');
      if (backdrop) backdrop.remove();
    }

    document.querySelectorAll('.sticker').forEach(el => el.addEventListener('click', () => toggle(el)));

    // delete from repeated view
    document.getElementById('rep-list').addEventListener('click', e => {
      const btn = e.target.closest('[data-del]');
      if (btn) changeRepeated(btn.dataset.del, -999);
    });

    // search in repeated
    document.getElementById('rep-search').addEventListener('input', e => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll('#rep-list .rep-sticker').forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(q) ? '' : 'none';
      });
    });

    // add modal
    const addModal = document.getElementById('rep-add-modal');
    document.getElementById('rep-add-open').addEventListener('click', () => {
      addModal.style.display = 'flex';
      setTimeout(() => document.getElementById('rep-add-search').focus(), 50);
    });
    addModal.addEventListener('click', e => { if (e.target === addModal) addModal.style.display = 'none'; });

    const allStickersList = Array.from(document.querySelectorAll('.sticker')).map(el => ({
      id: el.dataset.id,
      name: el.querySelector('.sname')?.textContent?.trim() ?? '',
    }));

    document.getElementById('rep-add-search').addEventListener('input', e => {
      const q = e.target.value.trim().toLowerCase();
      const container = document.getElementById('rep-add-results');
      if (!q) { container.innerHTML = ''; return; }
      const matches = allStickersList.filter(s => s.id.toLowerCase().includes(q) || s.name.toLowerCase().includes(q)).slice(0, 15);
      container.innerHTML = matches.map(s =>
        `<div data-add-id="${s.id}" style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0.4rem;border-radius:8px;cursor:pointer;color:#1e293b">
          <span style="font-weight:700;color:#38bdf8;min-width:52px;font-size:0.75rem">${s.id}</span>
          <span style="font-size:0.85rem">${s.name}</span>
        </div>`
      ).join('');
      container.querySelectorAll('[data-add-id]').forEach(row => {
        row.addEventListener('click', async () => {
          await changeRepeated(row.dataset.addId, 1);
          addModal.style.display = 'none';
          document.getElementById('rep-add-search').value = '';
          container.innerHTML = '';
        });
      });
    });

    // SCAN
    let scanFile = null;
    document.getElementById('btn-camera').addEventListener('click', () => document.getElementById('scan-input-camera').click());
    document.getElementById('btn-file').addEventListener('click', () => document.getElementById('scan-input-file').click());

    async function handleScanFile(file) {
      if (!file) return;
      scanFile = file;
      const preview = document.getElementById('scan-preview');
      const bitmap = await createImageBitmap(file).catch(() => null);
      if (bitmap) {
        const canvas = document.createElement('canvas');
        const scale = Math.min(1, 800 / Math.max(bitmap.width, bitmap.height));
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        preview.src = canvas.toDataURL('image/jpeg', 0.8);
      } else {
        preview.src = ''; preview.alt = `📷 ${file.name}`;
      }
      preview.classList.add('visible');
      document.getElementById('scan-btn').classList.add('visible');
      document.getElementById('scan-results').innerHTML = '';
    }

    document.getElementById('scan-input-camera').addEventListener('change', e => handleScanFile(e.target.files[0]));
    document.getElementById('scan-input-file').addEventListener('change', e => handleScanFile(e.target.files[0]));

    document.getElementById('scan-btn').addEventListener('click', async () => {
      if (!scanFile) return;
      const results = document.getElementById('scan-results');
      results.innerHTML = '<div class="scan-loading">⏳ Analizando imagen...</div>';

      // Convert to JPEG via canvas before sending
      let fileToSend = scanFile;
      const bitmap = await createImageBitmap(scanFile).catch(() => null);
      if (bitmap) {
        const canvas = document.createElement('canvas');
        const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        fileToSend = await new Promise(res => canvas.toBlob(res, 'image/jpeg', 0.85));
      }

      const form = new FormData();
      form.append('image', fileToSend);
      const res = await fetch('/api/scan', { method: 'POST', body: form });
      const data = await res.json();
      if (data.error) { results.innerHTML = `<div class="scan-loading">❌ ${data.error}</div>`; return; }
      if (!data.codes.length) { results.innerHTML = `<div class="scan-loading">No se detectaron códigos<br/><small style="opacity:0.5;word-break:break-all">${data.rawText || JSON.stringify(data.debug) || '(sin texto)'}</small></div>`; return; }

      function stickerLabel(code, isOwned) {
        const el = document.querySelector(`.sticker[data-id="${code}"]`);
        const name = el?.querySelector('.sname')?.textContent?.trim() || code;
        const clickable = !isOwned ? `data-mark="${code}" style="cursor:pointer"` : '';
        return `<div class="scan-card ${isOwned ? 'owned' : 'missing'}" ${clickable}>
          <div class="sc-code">${code}</div>
          <div class="sc-name">${name}</div>
        </div>`;
      }

      const total = data.owned.length + data.new.length;
      results.innerHTML = `
        <p style="font-size:0.8rem;color:#94a3b8;margin-bottom:0.6rem">
          ${total} carta${total !== 1 ? 's' : ''} detectada${total !== 1 ? 's' : ''}
          · <span style="color:#4ade80">${data.owned.length} ya tenés</span>
          · <span style="color:#f87171">${data.new.length} nueva${data.new.length !== 1 ? 's' : ''}</span>
        </p>
        <div class="scan-grid">
          ${[...data.owned.map(c => stickerLabel(c, true)), ...data.new.map(c => stickerLabel(c, false))].join('')}
        </div>
        ${data.unknown.length ? `<p style="font-size:0.7rem;color:#475569;margin-top:0.5rem">No reconocidas: ${data.unknown.join(', ')}</p>` : ''}
      `;

      // Click to mark missing stickers
      results.querySelectorAll('[data-mark]').forEach(card => {
        card.addEventListener('click', async () => {
          const id = card.dataset.mark;
          await fetch('/api/sticker', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, owned: true }),
          });
          card.classList.replace('missing', 'owned');
          card.removeAttribute('data-mark');
          card.style.cursor = '';
          // also update main grid
          const mainSticker = document.querySelector(`.sticker[data-id="${id}"]`);
          if (mainSticker) {
            mainSticker.classList.replace('missing', 'owned');
            // trigger counter update manually
            const section = mainSticker.dataset.section;
            const grid = mainSticker.closest('.sticker-grid');
            const sOwned = grid.querySelectorAll('.sticker.owned').length;
            const sTotal = grid.querySelectorAll('.sticker').length;
            const cnt = document.getElementById(`cnt-${section}`);
            if (cnt) { cnt.textContent = `${sOwned}/${sTotal}`; cnt.classList.toggle('complete', sOwned === sTotal); }
          }
          // update summary line
          const owned = results.querySelectorAll('.scan-card.owned').length;
          const missing = results.querySelectorAll('.scan-card.missing').length;
          const total = owned + missing;
          const p = results.querySelector('p');
          if (p) p.innerHTML = `${total} carta${total!==1?'s':''} detectada${total!==1?'s':''} · <span style="color:#4ade80">${owned} ya tenés</span> · <span style="color:#f87171">${missing} nueva${missing!==1?'s':''}</span>`;
        });
      });
    });
  </script>
  </div><!-- .app -->
</body>
</html>
