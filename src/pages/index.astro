---
import { getPool, initDB } from '../lib/db';
import { INTRO, FIFA_MUSEUM, TEAMS, COCA_COLA } from '../lib/stickers';

await initDB();
const { rows } = await getPool().query('SELECT id, owned FROM stickers');
const ownedSet = new Set(rows.filter(r => r.owned).map(r => r.id));

const totalAll = rows.length;
const totalOwned = ownedSet.size;

// precompute per-section stats for heatmap
const allSections = [
  { code: 'intro', name: 'Introducción', flag: '🌍', stickers: INTRO },
  ...TEAMS.map(t => ({ code: t.code, name: t.name, flag: t.flag, stickers: t.stickers })),
  { code: 'museum', name: 'FIFA Museum', flag: '🏆', stickers: FIFA_MUSEUM },
  { code: 'cocacola', name: 'Coca-Cola', flag: '🥤', stickers: COCA_COLA },
].map(s => {
  const owned = s.stickers.filter(x => ownedSet.has(x.id)).length;
  const pct = Math.round(owned / s.stickers.length * 100);
  return { ...s, owned, total: s.stickers.length, pct };
}).sort((a, b) => a.pct - b.pct);
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Álbum Leo & Gabi 2026</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100dvh; -webkit-tap-highlight-color: transparent; }
    .app { max-width: 480px; margin: 0 auto; background: #0f172a; }
    header { background: #0f172a; padding: 0.7rem 1rem 0.5rem; text-align: center; border-bottom: 1px solid #1e293b; position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,0.3); }
    header h1 { font-size: 1rem; font-weight: 800; color: #f1f5f9; }
    header p { font-size: 0.68rem; color: #475569; margin-top: 0.1rem; }
    .logout { position: absolute; top: 0.6rem; right: 0.75rem; font-size: 0.68rem; color: #475569; text-decoration: none; }
    .global-stats { display: flex; gap: 1rem; justify-content: center; margin-top: 0.3rem; font-size: 0.72rem; color: #64748b; }
    .global-stats strong { color: #94a3b8; }
    .progress-bar { width: 100%; margin: 0.35rem auto 0; height: 4px; background: #1e293b; border-radius: 2px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, #38bdf8, #818cf8); border-radius: 2px; transition: width 0.3s; }
    .tabs { display: flex; background: #0f172a; border-bottom: 1px solid #1e293b; position: sticky; top: 82px; z-index: 99; }
    .tab { flex: 1; padding: 0.55rem; text-align: center; font-size: 0.78rem; font-weight: 600; color: #475569; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.15s; }
    .tab.active { color: #38bdf8; border-bottom-color: #38bdf8; }
    nav { display: flex; overflow-x: auto; gap: 0.4rem; padding: 0.45rem 0.75rem; background: #0f172a; border-bottom: 1px solid #1e293b; position: sticky; top: 120px; z-index: 98; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    nav a { flex-shrink: 0; font-size: 0.68rem; padding: 0.25rem 0.55rem; border-radius: 20px; background: #1e293b; color: #64748b; text-decoration: none; white-space: nowrap; border: 1px solid #334155; }
    nav a:active { background: #334155; color: #e2e8f0; }
    main { padding: 0.75rem; }
    .section { margin-bottom: 1.5rem; scroll-margin-top: 165px; }
    .section-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; padding-bottom: 0.3rem; border-bottom: 1px solid #1e293b; cursor: pointer; }
    .section-header h2 { font-size: 0.88rem; font-weight: 700; color: #e2e8f0; }
    .section-flag { font-size: 1.2rem; line-height: 1; }
    .section-count { margin-left: auto; font-size: 0.68rem; color: #475569; }
    .section-count.complete { color: #4ade80; font-weight: 700; }
    .section-header .chevron { margin-left: 0.3rem; font-size: 0.7rem; color: #475569; transition: transform 0.2s; }
    .section.collapsed .sticker-grid { display: none; }
    .section.collapsed .chevron { transform: rotate(-90deg); }
    .sticker-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
    @media (min-width: 400px) { .sticker-grid { grid-template-columns: repeat(6, 1fr); } }
    @media (min-width: 600px) { .sticker-grid { grid-template-columns: repeat(8, 1fr); } }
    .sticker { aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 7px; cursor: pointer; border: 1.5px solid transparent; transition: transform 0.08s; user-select: none; padding: 3px; touch-action: manipulation; }
    .sticker:active { transform: scale(0.91); }
    .sticker .sid { font-size: 0.56rem; font-weight: 700; line-height: 1; }
    .sticker .sname { font-size: 0.4rem; line-height: 1.15; text-align: center; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 1px; }
    .sticker.owned   { background: #166534; border-color: #4ade80; color: #bbf7d0; }
    .sticker.missing { background: #1e293b; border-color: #334155; color: #475569; }
    .sticker.foil.owned   { background: linear-gradient(135deg, #854d0e, #ca8a04); border-color: #fbbf24; color: #fef9c3; }
    .sticker.foil.missing { background: #1c1917; border-color: #44403c; color: #57534e; }
    .sticker.photo.owned   { background: #1e3a5f; border-color: #38bdf8; color: #bae6fd; }
    .sticker.photo.missing { background: #0f1f33; border-color: #1e3a5f; color: #334155; }
    #view-heatmap { display: none; }
    #view-heatmap.visible { display: block; }
    .hidden { display: none !important; }
    .heatmap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    @media (min-width: 500px) { .heatmap-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 700px) { .heatmap-grid { grid-template-columns: repeat(4, 1fr); } }
    .hm-card { border-radius: 10px; padding: 0.6rem 0.5rem 0.5rem; display: flex; flex-direction: column; gap: 0.3rem; border: 1px solid rgba(255,255,255,0.06); cursor: pointer; }
    .hm-top { display: flex; align-items: center; gap: 0.4rem; }
    .hm-flag { font-size: 1.3rem; line-height: 1; }
    .hm-name { font-size: 0.7rem; font-weight: 700; color: #e2e8f0; line-height: 1.2; }
    .hm-pct { margin-left: auto; font-size: 0.75rem; font-weight: 800; }
    .hm-bar { height: 5px; border-radius: 3px; background: rgba(255,255,255,0.1); overflow: hidden; }
    .hm-fill { height: 100%; border-radius: 3px; transition: width 0.3s; }
    .hm-count { font-size: 0.6rem; color: #64748b; }
    .fab { position: fixed; bottom: 1.25rem; right: max(1.25rem, calc(50vw - 240px + 1.25rem)); z-index: 200; width: 52px; height: 52px; border-radius: 50%; background: #38bdf8; color: #0f172a; border: none; font-size: 1.3rem; cursor: pointer; box-shadow: 0 4px 14px rgba(56,189,248,0.4); display: flex; align-items: center; justify-content: center; touch-action: manipulation; }
    .search-overlay { display: none; position: fixed; inset: 0; z-index: 199; background: rgba(0,0,0,0.6); align-items: flex-start; justify-content: center; padding-top: 5rem; }
    .search-overlay.open { display: flex; }
    .search-box { background: #1e293b; border-radius: 14px; padding: 1rem; width: 90%; max-width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); }
    .search-box input { width: 100%; border: 1.5px solid #334155; border-radius: 8px; padding: 0.6rem 0.75rem; font-size: 1rem; outline: none; color: #e2e8f0; background: #0f172a; }
    .search-box input:focus { border-color: #38bdf8; }
    .search-results { margin-top: 0.6rem; max-height: 50vh; overflow-y: auto; }
    .search-result { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.4rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem; color: #e2e8f0; }
    .search-result:active { background: #334155; }
    .search-result .sr-id { font-weight: 700; color: #38bdf8; min-width: 52px; font-size: 0.75rem; }
    .search-result .sr-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .search-result .sr-dot.owned { background: #4ade80; }
    .search-result .sr-dot.missing { background: #334155; }
    .search-empty { font-size: 0.8rem; color: #475569; text-align: center; padding: 1rem; }

    /* scan view */
    #view-scan { display: none; padding: 1rem; }
    #view-scan.visible { display: block; }
    .scan-drop { border: 2px dashed #334155; border-radius: 12px; padding: 2rem 1rem; text-align: center; cursor: pointer; color: #64748b; font-size: 0.85rem; transition: border-color 0.15s; }
    .scan-drop:active { border-color: #38bdf8; }
    .scan-preview { width: 100%; border-radius: 10px; margin-top: 0.75rem; display: none; }
    .scan-preview.visible { display: block; }
    .scan-btn { width: 100%; margin-top: 0.75rem; padding: 0.7rem; background: #38bdf8; color: #0f172a; border: none; border-radius: 10px; font-size: 0.9rem; font-weight: 700; cursor: pointer; display: none; }
    .scan-btn.visible { display: block; }
    .scan-results { margin-top: 1rem; }
    .scan-group { margin-bottom: 0.75rem; }
    .scan-group h3 { font-size: 0.75rem; font-weight: 700; margin-bottom: 0.4rem; }
    .scan-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .chip { font-size: 0.72rem; padding: 0.2rem 0.5rem; border-radius: 20px; font-weight: 600; }
    .chip.owned   { background: #166534; color: #bbf7d0; }
    .chip.new     { background: #1e3a5f; color: #bae6fd; }
    .chip.unknown { background: #1e293b; color: #64748b; }
    .scan-loading { text-align: center; color: #64748b; font-size: 0.85rem; padding: 1rem; }
  </style>
</head>
<body>
  <div class="app">
  <header>

    <h1>✨ Álbum de Leo & Gabi ✨</h1>
    <p>⚽ Panini FIFA World Cup 2026™</p>
    <div class="global-stats">
      <span>Tengo: <strong id="g-owned">{totalOwned}</strong></span>
      <span>Faltan: <strong id="g-missing">{totalAll - totalOwned}</strong></span>
      <span>Total: <strong>{totalAll}</strong></span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" id="g-bar" style={`width:${(totalOwned/totalAll*100).toFixed(1)}%`}></div>
    </div>
  </header>

  <div class="tabs">
    <div class="tab active" id="tab-stickers" data-tab="stickers">🗂 Stickers</div>
    <div class="tab" id="tab-heatmap" data-tab="heatmap">🌡 Por país</div>
    <div class="tab" id="tab-scan" data-tab="scan">📷 Escanear</div>
  </div>

  <nav id="team-nav">
    <a href="#intro">Intro</a>
    {TEAMS.map(t => <a href={`#${t.code}`}>{t.flag} {t.name}</a>)}
    <a href="#museum">Museum</a>
    <a href="#cocacola">🥤 Coca-Cola</a>
  </nav>

  <!-- STICKERS VIEW -->
  <div id="view-stickers">
    <main>
      <div class="section collapsed" id="intro">
        <div class="section-header" data-toggle="intro">
          <span class="section-flag">🌍</span>
          <h2>Introducción</h2>
          <span class="section-count" id="cnt-intro">{INTRO.filter(s => ownedSet.has(s.id)).length}/{INTRO.length}</span>
          <span class="chevron">▾</span>
        </div>
        <div class="sticker-grid">
          {INTRO.map(s => (
            <div class={`sticker foil ${ownedSet.has(s.id) ? 'owned' : 'missing'}`} data-id={s.id} data-section="intro" title={`${s.id} - ${s.name}`}>
              <span class="sid">{s.id}</span>
              <span class="sname">{s.name}</span>
            </div>
          ))}
        </div>
      </div>

      {TEAMS.map(t => {
        const teamOwned = t.stickers.filter(s => ownedSet.has(s.id)).length;
        return (
          <div class="section collapsed" id={t.code}>
            <div class="section-header" data-toggle={t.code}>
              <span class="section-flag">{t.flag}</span>
              <h2>{t.name}</h2>
              <span class={`section-count ${teamOwned === t.stickers.length ? 'complete' : ''}`} id={`cnt-${t.code}`}>{teamOwned}/{t.stickers.length}</span>
              <span class="chevron">▾</span>
            </div>
            <div class="sticker-grid">
              {t.stickers.map(s => (
                <div
                  class={`sticker ${s.foil ? 'foil' : s.name === 'Team Photo' ? 'photo' : ''} ${ownedSet.has(s.id) ? 'owned' : 'missing'}`}
                  data-id={s.id} data-section={t.code} title={`${s.id} - ${s.name}`}
                >
                  <span class="sid">{s.id}</span>
                  <span class="sname">{s.name}</span>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <div class="section collapsed" id="museum">
        <div class="section-header" data-toggle="museum">
          <span class="section-flag">🏆</span>
          <h2>FIFA Museum</h2>
          <span class="section-count" id="cnt-museum">{FIFA_MUSEUM.filter(s => ownedSet.has(s.id)).length}/{FIFA_MUSEUM.length}</span>
          <span class="chevron">▾</span>
        </div>
        <div class="sticker-grid">
          {FIFA_MUSEUM.map(s => (
            <div class={`sticker foil ${ownedSet.has(s.id) ? 'owned' : 'missing'}`} data-id={s.id} data-section="museum" title={`${s.id} - ${s.name}`}>
              <span class="sid">{s.id}</span>
              <span class="sname">{s.name}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="section collapsed" id="cocacola">
        <div class="section-header" data-toggle="cocacola">
          <span class="section-flag">🥤</span>
          <h2>Coca-Cola</h2>
          <span class="section-count" id="cnt-cocacola">{COCA_COLA.filter(s => ownedSet.has(s.id)).length}/{COCA_COLA.length}</span>
          <span class="chevron">▾</span>
        </div>
        <div class="sticker-grid">
          {COCA_COLA.map(s => (
            <div class={`sticker ${ownedSet.has(s.id) ? 'owned' : 'missing'}`} data-id={s.id} data-section="cocacola" title={`${s.id} - ${s.name}`}>
              <span class="sid">{s.id}</span>
              <span class="sname">{s.name}</span>
            </div>
          ))}
        </div>
      </div>
    </main>
  </div>

  <!-- HEATMAP VIEW -->
  <div id="view-heatmap">
    <main>
      <div class="heatmap-grid">
        {allSections.map(t => {
          // color: 0%=red, 50%=orange, 100%=green
          const r = t.pct < 50 ? 255 : Math.round(255 - (t.pct - 50) * 5.1);
          const g = t.pct < 50 ? Math.round(t.pct * 5.1) : 255;
          const bg = `rgba(${r},${g},80,0.15)`;
          const fill = `rgb(${r},${g},80)`;
          return (
            <div class="hm-card" style={`background:${bg}`} data-goto={t.code}>
              <div class="hm-top">
                <span class="hm-flag">{t.flag}</span>
                <span class="hm-name">{t.name}</span>
                <span class="hm-pct" style={`color:${fill}`}>{t.pct}%</span>
              </div>
              <div class="hm-bar"><div class="hm-fill" id={`hm-${t.code}`} style={`width:${t.pct}%;background:${fill}`}></div></div>
              <span class="hm-count" id={`hmc-${t.code}`}>{t.owned}/{t.total} figuritas</span>
            </div>
          );
        })}
      </div>
    </main>
  </div>

  <!-- SCAN VIEW -->
  <div id="view-scan">
    <div class="scan-drop" id="scan-drop">
      📷 Toca para tomar foto o elegir imagen<br/>
      <small style="opacity:0.6">del reverso de las cartas</small>
      <input type="file" id="scan-input" accept="image/*" capture="environment" style="display:none" />
    </div>
    <img id="scan-preview" class="scan-preview" alt="preview" />
    <button class="scan-btn" id="scan-btn">🔍 Reconocer cartas</button>
    <div class="scan-results" id="scan-results"></div>
  </div>

  <!-- FAB búsqueda -->
  <button class="fab" id="fab-search">🔍</button>
  <div class="search-overlay" id="search-overlay">
    <div class="search-box">
      <input type="text" id="search-input" placeholder="Buscar jugador o ID..." autocomplete="off" />
      <div class="search-results" id="search-results"></div>
    </div>
  </div>

  <script>
    const totalAll = document.querySelectorAll('.sticker').length;

    // COLLAPSIBLE
    document.querySelectorAll('[data-toggle]').forEach(header => {
      header.addEventListener('click', () => header.closest('.section').classList.toggle('collapsed'));
    });

    // TABS
    function switchTab(tab) {
      document.getElementById('view-stickers').classList.toggle('hidden', tab !== 'stickers');
      document.getElementById('team-nav').classList.toggle('hidden', tab !== 'stickers');
      document.getElementById('view-heatmap').classList.toggle('hidden', tab !== 'heatmap');
      document.getElementById('view-heatmap').classList.toggle('visible', tab === 'heatmap');
      document.getElementById('view-scan').classList.toggle('visible', tab === 'scan');
      document.getElementById('tab-stickers').classList.toggle('active', tab === 'stickers');
      document.getElementById('tab-heatmap').classList.toggle('active',  tab === 'heatmap');
      document.getElementById('tab-scan').classList.toggle('active',     tab === 'scan');
    }
    document.querySelectorAll('[data-tab]').forEach(el => el.addEventListener('click', () => switchTab(el.dataset.tab)));
    document.querySelectorAll('[data-goto]').forEach(el => {
      el.addEventListener('click', () => {
        switchTab('stickers');
        setTimeout(() => document.getElementById(el.dataset.goto)?.scrollIntoView({ behavior: 'smooth' }), 50);
      });
    });

    // SEARCH
    const allStickers = Array.from(document.querySelectorAll('.sticker')).map(el => ({
      el, id: el.dataset.id, section: el.dataset.section,
      name: el.querySelector('.sname')?.textContent ?? '',
    }));

    document.getElementById('fab-search').addEventListener('click', () => {
      document.getElementById('search-overlay').classList.add('open');
      setTimeout(() => document.getElementById('search-input').focus(), 50);
    });
    document.getElementById('search-overlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeSearch();
    });
    function closeSearch() {
      document.getElementById('search-overlay').classList.remove('open');
      document.getElementById('search-input').value = '';
      document.getElementById('search-results').innerHTML = '';
    }
    document.getElementById('search-input').addEventListener('input', e => {
      const q = e.target.value.trim().toLowerCase();
      const results = document.getElementById('search-results');
      if (!q) { results.innerHTML = ''; return; }
      const matches = allStickers.filter(s => s.id.toLowerCase().includes(q) || s.name.toLowerCase().includes(q)).slice(0, 20);
      if (!matches.length) { results.innerHTML = '<div class="search-empty">Sin resultados</div>'; return; }
      results.innerHTML = matches.map((s, i) =>
        `<div class="search-result" data-idx="${i}">
          <span class="sr-dot ${s.el.classList.contains('owned') ? 'owned' : 'missing'}"></span>
          <span class="sr-id">${s.id}</span>
          <span>${s.name}</span>
        </div>`
      ).join('');
      results.querySelectorAll('.search-result').forEach((row, i) => {
        row.addEventListener('click', () => {
          closeSearch();
          switchTab('stickers');
          const sec = document.getElementById(matches[i].section);
          if (sec?.classList.contains('collapsed')) sec.classList.remove('collapsed');
          setTimeout(() => {
            matches[i].el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            matches[i].el.style.outline = '3px solid #4299e1';
            setTimeout(() => matches[i].el.style.outline = '', 1500);
          }, 80);
        });
      });
    });

    // HEATMAP
    function heatColor(pct) {
      const r = pct < 50 ? 255 : Math.round(255 - (pct - 50) * 5.1);
      const g = pct < 50 ? Math.round(pct * 5.1) : 255;
      return { fill: `rgb(${r},${g},80)`, bg: `rgba(${r},${g},80,0.15)` };
    }

    // TOGGLE STICKER
    async function toggle(el) {
      const id = el.dataset.id;
      const section = el.dataset.section;
      const newOwned = !el.classList.contains('owned');
      await fetch('/api/sticker', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, owned: newOwned }),
      });
      el.classList.toggle('owned', newOwned);
      el.classList.toggle('missing', !newOwned);

      const grid = el.closest('.sticker-grid');
      const sOwned = grid.querySelectorAll('.sticker.owned').length;
      const sTotal = grid.querySelectorAll('.sticker').length;
      const cnt = document.getElementById(`cnt-${section}`);
      if (cnt) { cnt.textContent = `${sOwned}/${sTotal}`; cnt.classList.toggle('complete', sOwned === sTotal); }

      const pct = Math.round(sOwned / sTotal * 100);
      const { fill, bg } = heatColor(pct);
      const bar = document.getElementById(`hm-${section}`);
      if (bar) {
        bar.closest('.hm-card').style.background = bg;
        bar.style.width = pct + '%'; bar.style.background = fill;
        const pctEl = bar.closest('.hm-card').querySelector('.hm-pct');
        if (pctEl) { pctEl.textContent = pct + '%'; pctEl.style.color = fill; }
        const countEl = document.getElementById(`hmc-${section}`);
        if (countEl) countEl.textContent = `${sOwned}/${sTotal} figuritas`;
      }

      const gOwned = document.querySelectorAll('.sticker.owned').length;
      document.getElementById('g-owned').textContent = gOwned;
      document.getElementById('g-missing').textContent = totalAll - gOwned;
      document.getElementById('g-bar').style.width = `${(gOwned / totalAll * 100).toFixed(1)}%`;
    }

    document.querySelectorAll('.sticker').forEach(el => el.addEventListener('click', () => toggle(el)));

    // SCAN
    let scanFile = null;
    document.getElementById('scan-drop').addEventListener('click', () => document.getElementById('scan-input').click());
    document.getElementById('scan-input').addEventListener('change', e => {
      scanFile = e.target.files[0];
      if (!scanFile) return;
      const url = URL.createObjectURL(scanFile);
      const preview = document.getElementById('scan-preview');
      preview.src = url; preview.classList.add('visible');
      document.getElementById('scan-btn').classList.add('visible');
      document.getElementById('scan-results').innerHTML = '';
    });
    document.getElementById('scan-btn').addEventListener('click', async () => {
      if (!scanFile) return;
      const results = document.getElementById('scan-results');
      results.innerHTML = '<div class="scan-loading">⏳ Analizando imagen...</div>';
      const form = new FormData();
      form.append('image', scanFile);
      const res = await fetch('/api/scan', { method: 'POST', body: form });
      const data = await res.json();
      if (data.error) { results.innerHTML = `<div class="scan-loading">❌ ${data.error}</div>`; return; }
      if (!data.codes.length) { results.innerHTML = `<div class="scan-loading">No se detectaron códigos<br/><small style="opacity:0.5;word-break:break-all">${data.rawText || JSON.stringify(data.debug) || '(sin texto)'}</small></div>`; return; }
      results.innerHTML = `
        ${data.owned.length ? `<div class="scan-group"><h3 style="color:#4ade80">✅ Ya las tienes (${data.owned.length})</h3><div class="scan-chips">${data.owned.map(c => `<span class="chip owned">${c}</span>`).join('')}</div></div>` : ''}
        ${data.new.length ? `<div class="scan-group"><h3 style="color:#38bdf8">🆕 Nuevas (${data.new.length})</h3><div class="scan-chips">${data.new.map(c => `<span class="chip new">${c}</span>`).join('')}</div></div>` : ''}
        ${data.unknown.length ? `<div class="scan-group"><h3 style="color:#64748b">❓ No reconocidas (${data.unknown.length})</h3><div class="scan-chips">${data.unknown.map(c => `<span class="chip unknown">${c}</span>`).join('')}</div></div>` : ''}
      `;
    });
  </script>
  </div><!-- .app -->
</body>
</html>
