---
---
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Panini 2026 - Acceso</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, sans-serif;
      background: #3B3758;
      color: #f0f4f8;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      background: #4D6E81;
      border-radius: 16px;
      padding: 2rem 1.5rem;
      width: 100%;
      max-width: 320px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    h1 { font-size: 1.1rem; margin-bottom: 0.25rem; }
    p { font-size: 0.8rem; color: #8DA9B8; margin-bottom: 1.5rem; }

    .dots {
      display: flex; gap: 0.75rem; justify-content: center; margin-bottom: 1.5rem;
    }
    .dot {
      width: 14px; height: 14px; border-radius: 50%;
      background: #4D6E81; border: 2px solid #7AACB3;
      transition: background 0.15s;
    }
    .dot.filled { background: #7AACB3; border-color: #7AACB3; }

    .keypad {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }
    button {
      background: #4D6E81;
      border: none;
      border-radius: 12px;
      color: #f0f4f8;
      font-size: 1.4rem;
      font-weight: 600;
      padding: 1rem;
      cursor: pointer;
      transition: background 0.1s, transform 0.1s;
      -webkit-tap-highlight-color: transparent;
    }
    button:active { background: #7AACB3; transform: scale(0.95); }
    button.del { font-size: 1rem; color: #CBD5E0; }
    .error { color: #CF8DA8; font-size: 0.8rem; margin-top: 0.75rem; min-height: 1.2em; }
  </style>
</head>
<body>
  <div class="card">
    <h1>⚽ Panini 2026</h1>
    <p>Ingresa tu PIN de 4 dígitos</p>
    <div class="dots">
      <div class="dot" id="d0"></div>
      <div class="dot" id="d1"></div>
      <div class="dot" id="d2"></div>
      <div class="dot" id="d3"></div>
    </div>
    <div class="keypad">
      {[1,2,3,4,5,6,7,8,9].map(n => (
        <button data-n={n}>{n}</button>
      ))}
      <button></button>
      <button data-n="0">0</button>
      <button class="del" id="del">⌫</button>
    </div>
    <div class="error" id="err"></div>
  </div>

  <script>
    let pin = '';

    function press(n) {
      if (pin.length >= 4) return;
      pin += n;
      document.getElementById(`d${pin.length - 1}`).classList.add('filled');
      if (pin.length === 4) submit();
    }

    function del() {
      if (!pin.length) return;
      document.getElementById(`d${pin.length - 1}`).classList.remove('filled');
      pin = pin.slice(0, -1);
      document.getElementById('err').textContent = '';
    }

    async function submit() {
      const res = await fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pin }),
      });
      if (res.ok) {
        window.location.href = '/';
      } else {
        document.getElementById('err').textContent = 'PIN incorrecto';
        pin = '';
        document.querySelectorAll('.dot').forEach(d => d.classList.remove('filled'));
      }
    }

    document.querySelectorAll('[data-n]').forEach(btn => {
      btn.addEventListener('click', () => press(btn.dataset.n));
    });
    document.getElementById('del').addEventListener('click', del);
  </script>
</body>
</html>
